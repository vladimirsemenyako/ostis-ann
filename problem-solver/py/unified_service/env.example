# Application Settings
APP_NAME="OSTIS ANN Unified Service"
DEBUG=False

# Server Settings
HOST=0.0.0.0
PORT=8000

# LLM Settings - TinyLlama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=tinyllama
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# Database Settings
SQLITE_DB_NAME=unified_rag_app.db

# ChromaDB Settings
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_SEARCH_K=2

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TEMP_UPLOAD_DIR=./temp_uploads

# External API Tokens (optional)
GITHUB_TOKEN=your_github_token_here
GITHUB_PAT=your_github_pat_here
HF_TOKEN=your_huggingface_token_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=unified_service.log

